{
  "name": "printflow",
  "version": "0.1.0",
  "private": true,
  "description": "PrintFlow — skip-the-queue college print ordering (PWA + Electron shop app)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspace=apps/web",
    "build:shared": "npm run build --workspace=packages/shared",
    "db:generate": "prisma generate --schema=packages/db/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=packages/db/prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema=packages/db/prisma/schema.prisma",
    "db:seed": "node scripts/seed-users.mjs",
    "lint": "npm run lint --workspace=apps/web",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.27.7": true,
    "sharp@0.33.5": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true
  }
}
