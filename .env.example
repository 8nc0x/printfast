# ---------- Database (Prisma / PostgreSQL) ----------
DATABASE_URL=postgresql://printflow:CHANGE_ME@localhost:5432/printflow?schema=public

# ---------- Auth.js (NextAuth v5) ----------
AUTH_SECRET=generate-with-`openssl rand -base64 32`
AUTH_URL=http://localhost:3000
# Google OAuth
AUTH_GOOGLE_ID=your-google-client-id
AUTH_GOOGLE_SECRET=your-google-client-secret

# ---------- Payments: PayXmint (https://payxmint.com/docs) ----------
PAYMENT_PROVIDER=payxmint
PAYXMINT_BASE_URL=https://payxmint.com
PAYXMINT_API_KEY=your-payxmint-api-key
PAYXMINT_WEBHOOK_SECRET=your-payxmint-webhook-secret

# ---------- Legacy/custom gateway (optional; PAYMENT_PROVIDER=custom) ----------
PAYMENT_GATEWAY_BASE_URL=
PAYMENT_GATEWAY_KEY=
PAYMENT_GATEWAY_SECRET=

# ---------- Storage (local disk; never inside public/) ----------
STORAGE_ROOT=/data/printflow
STORAGE_SIGNING_SECRET=generate-with-`openssl rand -base64 32`
SIGNED_URL_TTL_SECONDS=300

# ---------- Shop / Electron ----------
SHOP_TOKEN_SECRET=another-random-secret

# ---------- Server ----------
PORT=3000
NODE_ENV=production
